###################
# Logging helpers #
###################

# Send a decorated message to stdout, followed by a new line
#
say() {
    [ -t 1 ] && [ -n "$TERM" ] \
        && echo "$(tput setaf 2)[$MY_NAME]$(tput sgr0) $*" \
        || echo "[$MY_NAME] $*"
}

# Send a decorated message to stdout, without a trailing new line
#
say_noln() {
    [ -t 1 ] && [ -n "$TERM" ] \
        && echo -n "$(tput setaf 2)[$MY_NAME]$(tput sgr0) $*" \
        || echo "[$MY_NAME] $*"
}

# Send a warning-highlighted text to stdout
#
say_warn() {
    [ -t 1 ] && [ -n "$TERM" ] \
        && echo "$(tput setaf 3)[$MY_NAME] $*$(tput sgr0)" \
        || echo "[$MY_NAME] $*"
}

# Send a text message to stderr
#
say_err() {
    [ -t 2 ] && [ -n "$TERM" ] \
        && echo "$(tput setaf 1)[$MY_NAME] $*$(tput sgr0)" 1>&2 \
        || echo "[$MY_NAME] $*" 1>&2
}

# Exit with an error message and (optional) code
# Usage: die [-c <error code>] <error message>
#
die() {
    code=1
    [[ "$1" = "-c" ]] && {
        code="$2"
        shift 2
    }
    say_err "$@"
    exit "$code"
}

# Exit with an error message if the last exit code is not 0
#
ok_or_die() {
    code=$?
    [[ $code -eq 0 ]] || die -c $code "$@"
}

# Print an error message if the last exit code is not 0, but do not exit
#
# Use this for non-fatal errors
ok_or_say_err() {
  [[ $? -eq 0 ]] || say_err "$@"
}

#########################
# Miscellaneous helpers #
#########################

get_target() {
    if [[ $(uname -m) =~ "aarch64" ]]; then
        echo "--target=aarch64-unknown-linux-gnu"
        exit 0
    fi

    echo "--target=x86_64-unknown-linux-gnu"
}

# Builds an instrumented version of the specified fuzz harness
#
# Usage: instrument_binary <target>
# prints: The path to instrumented binary
instrument_binary() {
  target=$1

  # Subshell so that pipefail does not leak into the caller. Without it,
  # a cargo failure would be masked by jq exiting 0.
  (
    set -o pipefail

    # We have to use the gnu target for coverage collection,
    # as on aarch64-unknown-linux-musl the instrument-coverage
    # codegen option is not supported.
    RUSTFLAGS='-Cinstrument-coverage' \
        cargo build --bin "${target}_fuzz_target" \
                    --features stdin_fuzz \
                    --no-default-features \
                    --message-format=json \
                    --quiet "$(get_target)" \
        | jq -r 'select(.executable != null) |  .executable'
  )
}

prepare_firecracker() {
    branch=$1
    say "Preparing firecracker."

    if [ -d firecracker ]; then
        echo "Will use existing firecracker"
    else
        run_unpriv_bash_devctr "git clone https://github.com/firecracker-microvm/firecracker.git"
    fi
    ok_or_die "Failed to prepare Firecracker."

    # Do an explicit fetch + checkout of FETCH_HEAD so that
    # refs like 'pull/2/head' can be passed for $branch
    docker_cmd="git -C firecracker fetch origin $branch &&
        git -C firecracker checkout FETCH_HEAD && \
        cp firecracker/Cargo.lock ."
    run_unpriv_bash_devctr "$docker_cmd"
    ok_or_die "Failed to checkout $branch branch."
}

# Verifies that the given argument is a valid fuzz target
check_fuzz_target_arg() {
  [[ -z $1 ]] && \
     die "No fuzz target provided. Valid options are: $VALID_FUZZ_TARGETS_MSG."

  [[ " ${VALID_FUZZ_TARGETS[@]} " =~ " $1 " ]] || \
     die "Invalid fuzz target: $1. Valid options are: $VALID_FUZZ_TARGETS_MSG."
}

##################
# Docker helpers #
##################

# Check if Docker is available and exit if it's not.
# Upon returning from this call, the caller can be certain Docker is available.
#
ensure_docker() {
    NEWLINE=$'\n'
    output=$(which docker 2>&1)
    ok_or_die "Docker not found. Aborting." \
        "Please make sure you have Docker (http://docker.com) installed" \
        "and properly configured.${NEWLINE}" \
        "Error: $?, command output: ${output}"

    output=$(docker ps 2>&1)
    ok_or_die "Error accessing Docker. Please make sure the Docker daemon" \
        "is running and that you are part of the docker group.${NEWLINE}" \
        "Error: $?, command output: ${output}${NEWLINE}" \
        "For more information, see" \
        "https://docs.docker.com/install/linux/linux-postinstall/"
}

# Run a command and retry a number of times if it fails, sleeping between
# attempts. Returns 0 as soon as an attempt succeeds, or the exit code of
# the last attempt if all retries fail.
# $1 - retry count
# $2 - sleep interval between retries (seconds)
# $@ - command to run
retry_cmd() {
    local retry_cnt=$1
    local sleep_int=$2
    shift 2

    local rc=0
    local attempt
    for ((attempt = 1; attempt <= retry_cnt; attempt++)); do
        "$@" && return 0
        rc=$?
        if ((attempt < retry_cnt)); then
            say_warn "'$*' failed (attempt $attempt/$retry_cnt), retrying in ${sleep_int}s..."
            sleep "$sleep_int"
        fi
    done
    return "$rc"
}

# Attempt to download our Docker image. Exit if that fails.
# Upon returning from this call, the caller can be certain our Docker image is
# available on this system.
#
ensure_devctr() {

    # We depend on having Docker present.
    ensure_docker

    # Check if we have the container image available locally. Attempt to
    # download it, if we don't.
    [[ $(docker images -q "$DEVCTR_IMAGE" | wc -l) -gt 0 ]] || {
        say "About to pull docker image $DEVCTR_IMAGE"

        # Retry the pull a few times, as it can fail transiently
        # (network blips, registry throttling).
        retry_cmd 5 3 docker pull "$DEVCTR_IMAGE"

        ok_or_die "Error pulling docker image. Aborting."
    }
}

# Helper function to run the dev container.
# Usage: run_devctr <docker args> -- <container args>
# Example: run_devctr --privileged -- bash -c "echo 'hello world'"
run_devctr() {
    docker_args=()
    ctr_args=()
    docker_args_done=false
    while [[ $# -gt 0 ]]; do
        [[ "$1" = "--" ]] && {
            docker_args_done=true
            shift
            continue
        }
        [[ $docker_args_done = true ]] && ctr_args+=("$1") || docker_args+=("$1")
        shift
    done

    # If we're running in a terminal, pass the terminal to Docker and run
    # the container interactively
    [[ -t 0 ]] && docker_args+=("-i")
    [[ -t 1 ]] && docker_args+=("-t")

    # Try to pass these environments from host into container for network proxies
    proxies=(http_proxy HTTP_PROXY https_proxy HTTPS_PROXY no_proxy NO_PROXY)
    for i in "${proxies[@]}"; do
        if [[ -n ${!i-} ]]; then
            docker_args+=("--env") && docker_args+=("$i=${!i}")
        fi
    done

    # Cargo only reads .cargo/config.toml from its working directory upwards,
    # so builds outside $CTR_ROOT_DIR (e.g. in mktemp dirs) never
    # see its `net.retry`. Set it via the environment so every cargo call in
    # the container retries the same number of times. Keep the default in
    # sync with .cargo/config.toml.
    docker_args+=("--env" "CARGO_NET_RETRY=${CARGO_NET_RETRY:-10}")

    # Finally, run the dev container
    # Use 'z' on the --volume parameter for docker to automatically relabel the
    # content and allow sharing between containers.
    docker run "${docker_args[@]}" \
        --rm \
        --volume /dev:/dev \
        --volume "$ROOT_DIR:$CTR_ROOT_DIR:z" \
        --volume "$ROOT_DIR/build/cargo_registry:/usr/local/rust/registry:z" \
        --volume "$ROOT_DIR/build/cargo_git_registry:/usr/local/rust/git:z" \
        --workdir "$CTR_ROOT_DIR" \
        --env PYTHONDONTWRITEBYTECODE=1 \
        --mount type=tmpfs,tmpfs-size=32G,dst=/tmp:exec \
        "$DEVCTR_IMAGE" "${ctr_args[@]}"
}

# Usage: run_priv_bash_devctr <bash command>
# Runs the given bash command as root inside the docker container
run_priv_bash_devctr() {
  run_devctr \
    --privileged \
    --ulimit nofile=4096:4096 \
    --security-opt seccomp=unconfined \
    -- \
    bash -c "$1"
}

# Usage: run_priv_bash_devctr <bash command>
# Runs the given bash command as a user inside the docker container
run_unpriv_bash_devctr() {
  run_devctr \
    -u "$(id -u):$(id -g)" \
    -- \
    bash -c "$1"
}

# Make sure the build/ dirs are available. Exit if we can't create them.
# Upon returning from this call, the caller can be certain the build/ dirs exist.
#
ensure_build_dir() {
    for dir in "$BUILD_DIR" "$CARGO_TARGET_DIR" \
               "$CARGO_REGISTRY_DIR" "$CARGO_GIT_REGISTRY_DIR"; do
        mkdir -p "$dir" || die "Error: cannot create dir $dir"
        [ -x "$dir" ] && [ -w "$dir" ] || \
            {
                say "Wrong permissions for $dir. Attempting to fix them ..."
                chmod +x+w "$dir"
            } || \
            die "Error: wrong permissions for $dir. Should be +x+w"
    done
}
