MY_NAME="Coverage Frontend"

# Full path to the tools dir on the host.
TOOLS_DIR="$(realpath "$(dirname "$0")")"
source "${TOOLS_DIR}/constants"
source "${TOOLS_DIR}/functions"

# prints the help message
cmd_help() {
  cat << EOF
Firecracker Fuzzer $MY_NAME
Usage: $(basename "$0") [<args>]
    Turns the .profraw files generated by the coverage_backend tool into coverage reports
Options
    --target <target> [repeatable]
        The fuzz target for which coverage information was collected.
    --profraw <profraw file> [repeatable]
        The '.profraw' files generated by executing instrumented versions of the above listed target binaries.
        Can be a directory containing profraw files.
        Should be listed once per target.
    --source <path> [optional, repeatable]
        Specifies a file or directory whose sources should be included in the final coverage report.
        Can be specified multiple times if llvm reports are being generated, in which case the report will contain the
        union of all specified files/directories (note: only works for llvm reports).
    --report <report type> <output_file> [optional, repeatable]
        The type of coverage report to generate, and where to store it. Supported are
          + "llvm_summary":    print the output of "llvm-cov report"
          + "llvm_html":       generate a html report using "llvm-cov show" The coverage report will be a single file and
                               contain both region and line coverage, with trait implementations monomorphized.
          + "grcov_html":      generate a html report using grcov, and compress it into a tarball.
          + "grcov_coveralls"  generate a coveralls+ json report using grcov.
        Repeat the argument to generate multiple coverage reports at once.
Global arguments
    -h, --help
        Display this help message and exit.
EOF
}

# Attempts to resolve the full path to the requested llvm tool in the current rustup toolchain
# Usage: get_llvm_tool <tool>
# prints: the full path to the llvm tool
get_llvm_tool() {
  tool="$1"
  # Can't do "ok_or_die" here, as (1) find does not return non-0 if it doesnt find anything, and (2) `exit` will not
  # terminate the parent shell if this is executed in a subshell.
  path=$(find "$(rustc --print sysroot)" -name "$tool")

  if [ -z "$path" ]; then
    return 1
  fi

  echo "$path"
}

targets=()
profraw_files=()
sources=()
declare -A reports

while [ $# -gt 0 ]; do
  case "$1" in
    "-h"|"--help") { cmd_help; exit 0;} ;;
    --target) {
      shift
      check_fuzz_target_arg "$1"
      targets+=("$1")
    };;
    --profraw) {
      shift
      profraw_files+=("$1")
    };;
    --source) {
      shift
      sources+=("$1")
    };;
    --report) {
      shift
      reports["$1"]="$2"
      shift
    };;
    -*)
      die "Unknown argument: $1. Please use --help for help."
      ;;
    *)
      die "Unexpected argument: $1. Please use --help for help."
      ;;
  esac
  shift
done

[ "${#targets[@]}" -eq 0 ] && die "No fuzz target provided. Valid options are: $VALID_FUZZ_TARGETS_MSG."
[ "${#profraw_files[@]}" -eq 0 ] && die "No .profraw files specified"
[ "${#reports[@]}" -eq 0 ] && die "No reports requested"

# First, collect our instrumented binaries
binaries=()

for target in "${targets[@]}"; do
  say "Instrumenting $target binary"
  binaries+=("$(instrument_binary "$target")")
done

llvm_profdata=$(get_llvm_tool llvm-profdata)
ok_or_die "Could not find tool llvm-profdata. Do you have the llvm-tools-preview component installed?"

# merge all our .profraw files into a single .profdata file (even needed for just a single .profraw file, see
# https://clang.llvm.org/docs/UsersManual.html#profiling-with-instrumentation
# Note that grcov can accept .profdata files if they are renamed to .profraw (since it is just a proxy for
# llvm-profdata). Since grcov requires all profraw files to be in the same directory, not merging them by hand
# would require us to copy all coverage files to a shared location. This is very inefficient if there are many
# coverage files.
say "Merging .profraw files"
$llvm_profdata merge -output=build/coverage.profdata "${profraw_files[@]}"
ok_or_die "Failed to merge specified .profraw files"

for report_type in "${!reports[@]}"; do
  say "Generating $report_type report"

  output="${reports[$report_type]}";
  case "$report_type" in
    llvm_*) {
      llvm_cov=$(get_llvm_tool llvm-cov)
      ok_or_die "Could not find tool llvm-cov. Do you have the llvm-tools-preview component installed?"

      binary_string=""
      for binary in "${binaries[@]}"; do
        # first binary must be passed without '-object'
        if [ -z "${binary_string}" ]; then
          binary_string="$binary"
        else
          binary_string="$binary_string -object $binary"
        fi
      done

      case "$report_type" in
        llvm_summary) {
          # generate the coverage report (disable branch summary since rust binaries do not generate branch coverage data)
          $llvm_cov report -show-branch-summary=false -use-color=false -instr-profile build/coverage.profdata $binary_string "${sources[@]}"
        } ;;
        llvm_html) {
          $llvm_cov show -format html -show-line-counts-or-regions -instr-profile build/coverage.profdata \
                    $binary_string "${sources[@]}" > "$output"
        } ;;
        *)
          die "Unknown llvm report type: $report_type"
          ;;
      esac
    } ;;
    grcov_*) {
      # grcov is a lot less flexible than llvm_cov. It needs all binaries to be in the same directory. It also expects
      # all .profraw files to be under some known root directory (sub directories are fine though). To ensure this,
      # create a temporary directory and copy everything it needs there.
      grcov_temp_dir=$(mktemp -d)
      for bin in "${binaries[@]}"; do
        cp "$bin" "$grcov_temp_dir/"
      done

      # Rename to profraw as grcov collects input files based on file ending
      cp build/coverage.profdata "$grcov_temp_dir/coverage.profraw"

      case "$report_type" in
        grcov_html) {
          grcov "$grcov_temp_dir" -s firecracker --binary-path "$grcov_temp_dir" --ignore-not-existing \
                  -t html -o "$grcov_temp_dir/coverage"
          tar -czf "$output" -C "$grcov_temp_dir" coverage
        };;
        grcov_coveralls) {
          # We need to generate the coverage report from within the git repository of which we want to generate
          # the report so that grcov correctly populates the "git" key in the report.
          # We need to pass `--commit-sha` as grcov fails to figure it out itself (it we don't pass it, grcov sets it to
          # the empty string, and that causes the "git" key of the report to be nonsense)
          # We need to pass `--token` because its a required argument by grcov, but only used if the report actually
          # is uploaded to the coveralls.io website. We don't do that, so its fine to put nonsense here. 
          (
            cd firecracker
            grcov "$grcov_temp_dir" -s . --binary-path "$grcov_temp_dir" --ignore-not-existing \
                  -t coveralls+ -o "$grcov_temp_dir/coverage.out" --commit-sha "$(git rev-parse HEAD)" --token none
          )
          mv "$grcov_temp_dir/coverage.out" "$output"
        };;
        *)
          die "Unknown grcov report type: $report_type"
          ;;
      esac

      rm -rf "$grcov_temp_dir"
    } ;;
    *)
      die "Unknown report type: $report_type"
      ;;
  esac
done
