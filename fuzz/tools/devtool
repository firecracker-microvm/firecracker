# Fuzzer devtool
#
# Use this script to start a fuzzing session for Firecracker.
#
# TL;DR
# Make sure you have Docker installed and properly configured
# (http://docker.com). Then,
#   fuzzing: `./devtool afl_fuzz block`
#     Then find the binaries under build/debug/
#   deep-dive: `./devtool shell`
#     Open a shell prompt inside the container. Then build or test (or do
#     anything, really) manually.

# Naming things is hard
MY_NAME="Firecracker Fuzzer $(basename "$0")"

# Full path to the tools dir on the host.
TOOLS_DIR="$(realpath "$(dirname "$0")")"
source "${TOOLS_DIR}/constants"
source "${TOOLS_DIR}/functions"

# Fix build/ dir permissions after a privileged container run.
# Since the privileged container runs as root, any files it creates will be
# owned by root. This fixes that by recursively changing the ownership of build/
# to the current user.
#
fix_build_dir_perms() {
    # Yes, running Docker to get elevated privileges, just to chown some files
    # is a dirty hack.
    run_devctr -- chown -R "$(id -u):$(id -g)" "$CTR_BUILD_DIR"
}

# Fix fuzzing out/ dir permissions after a privileged container run.
# Since the privileged container runs as root, any files it creates will be
# owned by root. This fixes that by recursively changing the ownership of out/
# to the current user.
#
fix_fuzz_dir_perms() {
    run_devctr -- chown -R "$(id -u):$(id -g)" "${CTR_FUZZ_OUTPUT_DIR}_$1"
}

# Helper function to start a number of AFL instances.
# Args:
#   $1  the number of AFL instances to be started.
#   $2  path to the fuzzed binary.
#   $3  cargo afl fuzz args.
run_afl_fuzzers() {
    local instances_to_start="$1"
    local fuzz_target="$2"
    local fuzz_output="$3"
    local afl_args=("${@:4}")

    # disable the ASCII UI that afl++ displays, as it breaks in the CI
    # and spams the logs
    export AFL_NO_UI=1

    # Do not suppress stdout/stderr out from the fuzz target.
    # This can result in a lot of console spam, but is the
    # easiest/only way to get any sort of information about
    # spurious failures
    export AFL_DEBUG_CHILD=1

    # disable the creation of README.txt files in the crashes
    # directories. These would otherwise have to be filtered
    # out when automatically collecting backtraces from
    # the crash files
    export AFL_NO_CRASH_README=1

    if [[ "$fuzz_target" == *"vcpu_fuzz_target" ]] || [[ "$fuzz_target" = *"snapshot_fuzz_target" ]] || [[ "$fuzz_target" = *"bus_access_fuzz_target" ]]; then
        # The vcpu and snapshot fuuz targets have a memory leak, so if we
        # run the fuzzer loop for too many iterations, we get OOM related false-positives
        # Thus, just reduce the loop count to 1000 (the default prior to afl 0.15.0 that
        # we know to not cause issues) so that the fuzz process is recycled every so often,
        # to clear up the memory leaks.
        #
        # This potential memory leak is not a problem for production usecases of firecracker,
        # as a "load snapshot" operation can only happen once during the lifecycle of
        # the firecracker process (so they cannot possibly accumulate like here).
        export AFL_FUZZER_LOOPCOUNT=1000
    fi

    # ensure that we get as much information in stderr about panics
    # in case they do not reproduce during post-mortem.
    export RUST_BACKTRACE=full

    for i in $(seq -f "%02g" 2 "$instances_to_start"); do
        # create these directories ahead of time, for the stderr redirection to work
        mkdir -p "$fuzz_output/fuzzer$i"
        screen -d -m bash -c "cargo afl fuzz \
            -S fuzzer$i \
            ${afl_args[*]} \
            -- \
            \"$fuzz_target\" \
             2> \"$fuzz_output/fuzzer${i}/stderr\""
    done

    mkdir -p "$fuzz_output/fuzzer01";
    cargo afl fuzz \
        -M fuzzer01 \
        "${afl_args[@]}" \
        -- \
        "$fuzz_target" \
         2> "$fuzz_output/fuzzer01/stderr"
}

# `$0 help`
# Show the detailed devtool usage information.
#
cmd_help() {
  cat << EOF
Firecracker Fuzzer $(basename "$0")
Usage: $(basename "$0") [<args>] <command> [<command args>]

Global arguments
    -y, --unattended         Run unattended. Assume the user would always
                             answer \"yes\" to any confirmation prompt.

Available commands:
    help
        Display this help message.
    shell [--privileged]
        Launch the development container and open an interactive BASH shell.
        -p, --privileged    Run the container as root, in privileged mode.
                            Running Firecracker via the jailer requires elevated
                            privileges, though the build phase does not.
    fix_perms
        Fixes permissions when devtool dies in the middle of a privileged session.

    build_debug <fuzz_target> [-b|--branch <branch>]
        Build the specified fuzz target in debug mode for crash analysis.
        -b, --branch      Firecracker branch to build against. Defaults to "main".

    build_afl <fuzz_target> [-b|--branch <branch>]
        Build the specified fuzz target in release mode with AFL instrumentation.
        -b, --branch      Firecracker branch to build against. Defaults to "main".

    check [-b|--branch <branch>]
        Type-check all fuzz targets against a Firecracker branch without building
        AFL binaries or fuzzing. Intended for Firecracker's PR CI to run against a
        PR branch, catching API changes that break the fuzzer before they merge.
        -b, --branch      Firecracker branch to check against. Defaults to "main".

    fuzz_afl <fuzz_target> [-t <cores>] [-b <branch>] [-- [<cargo afl fuzz args>]]
        Fuzz the specified target using AFL.
        cargo afl is used to fuzz the target. All arguments after -- will be passed
        through to cargo afl fuzz.
        The fuzzer will run indefinitely by default. Pass -V <duration_in_sec> to AFL++
        to change the fuzzer running time.
        fuzz_target       Fuzz the specified target with AFL.
                          Valid options are: $VALID_FUZZ_TARGETS_MSG.
        -t                How many cores should be used to fuzz in parallel.
                          Defaults to 4
        -b, --branch      What branch of firecracker to compile the fuzz harness against.
                          Defaults to "main"
EOF
}

# Fix build/ dir permissions after a privileged container run.
# Since the privileged container runs as root, any files it creates will be
# owned by root. This fixes that by recursively changing the ownership of build/
# to the current user.
#
cmd_fix_perms() {
    fix_build_dir_perms
    fix_fuzz_dir_perms "$1"
}

get_environment() {
    env="rustc --version > ./out_${1}/env; cargo afl --version >> ./out_${1}/env"
    run_priv_bash_devctr "$env"
    ok_or_die "Failed to get the environment."
}

prepare_env() {
    # Prepare environment to run fuzzers.
    docker_cmd="echo core > /proc/sys/kernel/core_pattern; \
	    cd /sys/devices/system/cpu/; \
	    echo performance | tee cpu*/cpufreq/scaling_governor; \
	    cd /fuzzer"
    run_priv_bash_devctr "$docker_cmd"
    ok_or_die "Could not setup the necessary environment."

    if [[ "$BUILDKITE" = "true" ]]; then
      # 12 GiB of 2M hugetlbfs pages. We run fuzzers on ag=n instances, meaning at most 12 fuzzers
      # run in parallel. Give each of them 1G of hugepages, as each harness only uses a few MiB, this will be
      # enough at the limited parallelism we run the fuzzers at (4 parallel threads per fuzzer).
      # Only set this up in buildkite to prevent draining a dev-laptop's memory with hugepage allocation.
      run_priv_bash_devctr "echo 6144 |tee /proc/sys/vm/nr_hugepages"
      ok_or_die "Failed to allocate hugepages."
    fi
}

cmd_build_seeds() {
  ensure_devctr
  ensure_build_dir

  pushd firecracker

  # preparation of some of the snapshot seeds requires guest kernels, so just download CI artifacts
  ./tools/devtool ensure_current_artifacts
  ok_or_die "Failed to download CI artifacts."

  popd

  run_priv_bash_devctr "cargo test"
  ok_or_die "Failed to generate fuzzing seeds."

  fix_build_dir_perms
  run_devctr -- chown -R "$(id -u):$(id -g)" "$CTR_ROOT_DIR/in"
}

cmd_build_debug() {
  ensure_devctr
  ensure_build_dir

  branch="main"
  target=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -b|--branch) branch="$2"; shift ;;
      *) target="$1" ;;
    esac
    shift
  done

  [ -n "$target" ] || die "Usage: $0 build_debug <fuzz_target> [-b|--branch <branch>]"

  prepare_firecracker "$branch"

  say "Building $target in debug mode"
  run_priv_bash_devctr "cargo build --bin ${target}_fuzz_target --features stdin_fuzz --no-default-features $(get_target)"
  ok_or_die "Failed to build target ${target}"

  fix_build_dir_perms
}

cmd_build_afl() {
  ensure_devctr
  ensure_build_dir

  branch="main"
  target=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -b|--branch) branch="$2"; shift ;;
      *) target="$1" ;;
    esac
    shift
  done

  [ -n "$target" ] || die "Usage: $0 build_afl <fuzz_target> [-b|--branch <branch>]"

  prepare_firecracker "$branch"

  say "Building $target in release mode with AFL instrumentation"
  run_priv_bash_devctr "cargo afl build --release --bin ${target}_fuzz_target $(get_target)"
  ok_or_die "Failed to build target ${target}"

  fix_build_dir_perms
}

cmd_check() {
  ensure_devctr
  ensure_build_dir

  branch="main"

  while [ $# -gt 0 ]; do
    case "$1" in
      -b|--branch) branch="$2"; shift ;;
      *) die "Usage: $0 check [-b|--branch <branch>]" ;;
    esac
    shift
  done

  prepare_firecracker "$branch"

  # Type-check all targets without building AFL binaries or fuzzing. Meant to
  # run from Firecracker's PR CI against the PR branch, so an API change that
  # breaks the fuzzer is caught on the Firecracker PR that causes it.
  say "Checking all fuzz targets against firecracker branch '$branch'"
  run_priv_bash_devctr "cargo check --all-targets $(get_target)"
  ok_or_die "Fuzz targets failed to compile against firecracker '$branch'"

  fix_build_dir_perms
}

# `$0 afl_fuzz` - fuzz a target using AFL
# Please see `$0 help` for more information.
#
cmd_fuzz_afl() {
    instances_to_start=4
    firecracker_branch="main"
    # Default binary memory limit.
    mem_limit=512

    while [ $# -gt 0 ]; do
        case "$1" in
            "-h"|"--help")  { cmd_help; exit 1; } ;;
            "-t")           { instances_to_start=$2; shift; } ;;
            "-b"|"--branch") { firecracker_branch=$2; shift; } ;;
            "--")           { shift; break;     } ;;
            --*|-*)
                die "Unknown argument: $1. Please use --help for help."
                ;;
            *)
                fuzz_target="$1"
                ;;
        esac
        shift
    done

    check_fuzz_target_arg "$fuzz_target"

    # Check prerequisites.
    ensure_devctr
    ensure_build_dir

    afl_args=("$@ -t 2000")

    # Add the default memory limit if we did not get them in the fuzz command.
    if [[ "$fuzz_target" = "vcpu" || "$fuzz_target" = "bus_access" ]]; then
      add_default_mem_limit=false
    else
      add_default_mem_limit=true
    fi
    for flag in "${afl_args[@]}"; do
        if [ "$flag" == "-m" ]; then
          add_default_mem_limit=false;
        fi
    done

    prepare_firecracker "$firecracker_branch"
    cmd_build_seeds

    say "Starting release build ..."
    # 'set -o pipefail' so that a cargo failure is not masked by jq exiting 0.
    docker_cmd="set -o pipefail; cargo afl build --release --bin ${fuzz_target}_fuzz_target \
                                --message-format=json --quiet $(get_target) \
                      | jq -r 'select(.executable != null) |  .executable'"
    fuzz_target_bin_abs=$(run_priv_bash_devctr "$docker_cmd")
    # If `cargo build` was not successful, we exit.
    ok_or_die "Could not build the project"

    [[ $add_default_mem_limit = true ]] && afl_args+=(-m "$mem_limit")
    # Add the default input/output dirs.
    afl_args+=(-i "$CTR_FUZZ_INPUT_DIR/$fuzz_target")
    afl_args+=(-o "${CTR_FUZZ_OUTPUT_DIR}_${fuzz_target}")

    [[ -z "$fuzz_target_bin_abs" ]] && \
        die "Fuzz target binary not found!"

    prepare_env
    docker_cmd="$(declare -f run_afl_fuzzers)
        run_afl_fuzzers $instances_to_start $fuzz_target_bin_abs \"out_${fuzz_target}\" ${afl_args[@]}"
    run_priv_bash_devctr "$docker_cmd"
    afl_exit_code=$?

    # afl++ exits with status code 0 even if it finds crashes in the fuzz target.
    # It will exit with code 130 if it got interrupted with CTRL+C. All other exit codes
    # indicate that AFL++ itself crashed, so die
    if [ "$afl_exit_code" -ne 0 ] && [ "$afl_exit_code" -ne 130 ]; then
      die "AFL++ crashed with exit code $afl_exit_code"
    fi

    say "Fuzzing session ended successfully."
    say "Fuzzing output placed under ${FUZZ_OUTPUT_DIR}_${fuzz_target}."

    get_environment "$fuzz_target"

    fix_fuzz_dir_perms "$fuzz_target"
    ok_or_say_err "Could not fix the output directory permissions."

    docker_cmd="python3 ./tools/collect_statistics.py $fuzz_target"
    run_unpriv_bash_devctr "$docker_cmd"
    ok_or_say_err "Could not collect the statistics."

    say "Output dir placed under ${FUZZ_OUTPUT_DIR}_${fuzz_target}"

    docker_cmd="$CTR_ROOT_DIR/tools/coverage_backend \"$fuzz_target\""
    run_priv_bash_devctr "$docker_cmd"
    ok_or_say_err "Could not collect coverage data."

    docker_cmd="$CTR_ROOT_DIR/tools/coverage_frontend --target \"$fuzz_target\" \\
                     --profraw \"${CTR_FUZZ_OUTPUT_DIR}_${fuzz_target}/raw_coverage/\" \\
                     --report llvm_summary stdout \\
                     --report llvm_html \"${CTR_FUZZ_OUTPUT_DIR}_$fuzz_target/coverage.html\"\\
                     --report grcov_html \"${CTR_FUZZ_OUTPUT_DIR}_$fuzz_target/coverage.tar.gz\"\\
                     $(relevant_files_for_target "$fuzz_target")"
    run_priv_bash_devctr "$docker_cmd"
    ok_or_say_err "Could not generate coverage reports."

    # Cleanup the files we just created
    run_priv_bash_devctr "rm -rf ${CTR_FUZZ_OUTPUT_DIR}_${fuzz_target}/raw_coverage/"

    # Re-run all crashes the fuzzer found to collect backtraces and deal with expected crashes
    docker_cmd="$CTR_ROOT_DIR/tools/reproduce $fuzz_target"
    run_priv_bash_devctr "$docker_cmd"

    crashes_found=0
    for fuzzer_dir in "${FUZZ_OUTPUT_DIR}_${fuzz_target}"/fuzzer*/; do
      for crash in "${fuzzer_dir}"crashes/*; do
        # filter out the backtrace files and 'expected' directories that we create
        [ "${crash: -10}" == .backtrace ] && continue
        [ -d "$crash" ] && continue

        crashes_found=$((crashes_found + 1))
      done;
    done;

    if [ $crashes_found -ne 0 ]; then
      say_err "Fuzzing target ${fuzz_target} yielded ${crashes_found} crashes." \
              "Backtraces have been stored in the out_${fuzz_target}/fuzzer*/crashes" \
              "directories on a best-effort basis. Check the AFL++ logs to investigate" \
              "unreproducible crashes"
    else
      say "Fuzzing target $fuzz_target concluded without finding any unexpected crashes. Whoop!"
    fi

    cmd_fix_perms $fuzz_target

    # Compress the crashes here to include the .backtrace files
    docker_cmd="cd out_$fuzz_target && tar czf crashes.tar.gz ./fuzzer*/crashes"
    run_unpriv_bash_devctr "$docker_cmd"
    ok_or_die "Could not compress crashes."

    docker_cmd="cd out_$fuzz_target && tar czf hangs.tar.gz ./fuzzer*/hangs"
    run_unpriv_bash_devctr "$docker_cmd"
    ok_or_die "Could not compress hangs."

    [ $crashes_found -eq 0 ]
}

# For each fuzz target, gets the list of sources that should be included in coverage reports
relevant_files_for_target() {
  virtio_common="--source firecracker/src/vmm/src/devices/virtio/device.rs \
                 --source firecracker/src/vmm/src/devices/virtio/queue.rs"
  case "$1" in
    "block") {
      # Exclude io_uring modules, since block fuzzer only targets the sync engine
      echo "--source firecracker/src/vmm/src/devices/virtio/block/virtio/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/io/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/io/sync_io.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/request.rs" \
           "$virtio_common"
    };;
    "block_mq") {
      # The "block" scope plus what only block_mq reaches
      echo "--source firecracker/src/vmm/src/devices/virtio/block/virtio/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/worker.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/persist.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/persist.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/io/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/io/sync_io.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/io/async_io.rs" \
           "--source firecracker/src/vmm/src/io_uring" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/block/virtio/request.rs" \
           "--source firecracker/src/vmm/src/vstate/memory_slice.rs" \
           "$virtio_common"
    };;
    "net") {
      echo "--source firecracker/src/vmm/src/devices/virtio/net/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/net/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/net/tap.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/iovec.rs" \
           "--source firecracker/src/vmm/src/dumbo" \
           "--source firecracker/src/vmm/src/mmds" \
           "$virtio_common"
    };;
    "legacy") {
      echo "--source firecracker/src/vmm/src/devices/bus.rs" \
           "--source firecracker/src/vmm/src/devices/legacy"
    };;
    "rng") {
      echo "--source firecracker/src/vmm/src/devices/virtio/rng/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/rng/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/iovec.rs" \
           "$virtio_common"
    };;
    "mem_hotplug") {
      echo "--source firecracker/src/vmm/src/devices/virtio/mem/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/mem/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/mem/request.rs" \
           "$virtio_common"
    };;
    "vsock") {
      echo "--source firecracker/src/vmm/src/devices/virtio/vsock/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/vsock/csm" \
           "--source firecracker/src/vmm/src/devices/virtio/vsock/unix" \
           "--source firecracker/src/vmm/src/devices/virtio/vsock/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/vsock/packet.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/iovec.rs" \
           "$virtio_common"
    };;
    "pmem") {
      echo "--source firecracker/src/vmm/src/devices/virtio/pmem/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/pmem/device.rs" \
           "$virtio_common"
    };;
    "balloon") {
      echo "--source firecracker/src/vmm/src/devices/virtio/balloon/device.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/balloon/mod.rs" \
           "--source firecracker/src/vmm/src/devices/virtio/balloon/util.rs" \
           "$virtio_common"
    };;
    "vcpu") {
      echo "--source firecracker/src/vmm/src/vstate" \
           "--source firecracker/src/vmm/src/vmm_config/machine_config.rs"
    } ;;
    "snapshot") {
      for persist_rs in $(find firecracker -name persist.rs); do
        echo -n "--source $persist_rs "
      done
      echo " --source firecracker/src/vmm/src/snapshot" \
           "--source firecracker/src/vmm/src/vstate" \
           "--source firecracker/src/vmm/src/arch/" \
           "--source firecracker/src/vmm/src/builder.rs"
    } ;;
    "bus_access") {
        echo "--source firecracker/src/pci/src/bus.rs" \
             "--source firecracker/src/pci/src/configuration.rs" \
             "--source firecracker/src/pci/src/device.rs" \
             "--source firecracker/src/pci/src/lib.rs" \
             "--source firecracker/src/pci/src/msix.rs" \
             "--source firecracker/src/vmm/src/devices/virtio/transport/mmio.rs" \
             "--source firecracker/src/vmm/src/devices/virtio/transport/pci/common_config.rs" \
             "--source firecracker/src/vmm/src/devices/virtio/transport/pci/device.rs" \
             "--source firecracker/src/vmm/src/vstate/vm.rs"
    } ;;
    *) {
      echo "--source firecracker/src"
    }
  esac
}

# `$0 shell` - drop to a shell prompt inside the dev container
# Please see `$0 help` for more information.
#
cmd_shell() {

    # By default, we run the container as the current user.
    privileged=false
    cmd="echo \"Specify a command\""
    execute_cmd=false

    # Parse any command line args.
    while [ $# -gt 0 ]; do
        case "$1" in
            "-h"|"--help")          { cmd_help; exit 1; } ;;
            "-p"|"--privileged")    { privileged=true;  } ;;
            "-c"|"--command")       { cmd=$2; execute_cmd=true;shift;shift;shift;break;  } ;;
            *)
                die "Unknown argument: $1. Please use --help for help."
            ;;
        esac
        shift
    done

    # Make sure we have what we need to continue.
    ensure_devctr
    ensure_build_dir

    privileged_cmd="run_devctr \
                --privileged \
                --ulimit nofile=4096:4096 \
                --security-opt seccomp=unconfined \
                --workdir '$CTR_ROOT_DIR' \
                -- \
                bash"
    unprivileged_cmd="run_devctr \
                --user '$(id -u):$(id -g)' \
                --ulimit nofile=4096:4096 \
                --device=/dev/kvm:/dev/kvm \
                --workdir '$CTR_ROOT_DIR' \
                --env PS1='$(whoami)@\h:\w\$ ' \
                -- \
                bash --norc"

    if [[ $privileged = true ]]; then
        # If requested, spin up a privileged container.
        #
        say "Dropping to a privileged shell prompt ..."
        say "Note: $ROOT_DIR is bind-mounted under $CTR_ROOT_DIR"
        say_warn "You are running as root; any files that get created under" \
            "$CTR_ROOT_DIR will be owned by root."
        if [[ $execute_cmd = true ]]; then
            privileged_cmd="${privileged_cmd} -c '$cmd'"
            eval "$privileged_cmd"
            ok_or_die "Failed to execute command in privileged container."
        else
            eval "$privileged_cmd"
            ok_or_die "Failed to start privileged container."
        fi

        # Running as root may have created some root-owned files under the build
        # dir. Let's fix that.
        #
        fix_build_dir_perms
    else
        say "Dropping to shell prompt as user $(whoami) ..."
        say "Note: $ROOT_DIR is bind-mounted under $CTR_ROOT_DIR"
        say_warn "You won't be able to run Firecracker via the jailer," \
            "but you can still build it."
        say "You can use \`$0 shell --privileged\` to get a root shell."

        [ -w /dev/kvm ] || \
            say_warn "WARNING: user $(whoami) doesn't have permission to" \
                "access /dev/kvm. You won't be able to run Firecracker."

        if [[ $execute_cmd = true ]]; then
            unprivileged_cmd="${unprivileged_cmd} -c '$cmd'"
            eval "$unprivileged_cmd"
            ok_or_die "Failed to execute command unprivileged container."
        else
            eval "$unprivileged_cmd"
            ok_or_die "Failed to star command unprivileged container."
        fi

    fi
}

cmd_fmt() {
  ensure_devctr

  check=false

  # Parse any command line args.
  while [ $# -gt 0 ]; do
    case "$1" in
      "--check") { check="true"; shift; } ;;
      *)
        die "Unknown argument: $1. Please use --help for help."
      ;;
    esac
    shift
  done
  opts=""
  if [ $check == "true" ]; then
    opts="--check"
  fi
  run_priv_bash_devctr "cargo fmt --all -- $opts"
}

main() {
    if [ $# = 0 ]; then
	    die "No command provided. Please use \`$0 help\` for help."
    fi

    # Parse main command line args.
    #
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)              { cmd_help; exit 1;     } ;;
            -y|--unattended)        # purpusefully ignored
                ;;
            -*)
                die "Unknown arg: $1. Please use \`$0 help\` for help."
            ;;
            *)
                break
            ;;
        esac
        shift
    done

    # $1 is now a command name. Check if it is a valid command and, if so,
    # run it.
    #
    declare -f "cmd_$1" > /dev/null
    ok_or_die "Unknown command: $1. Please use \`$0 help\` for help."

    cmd=$1
    shift

    # $@ is now a list of command-specific args
    #
    cmd_"$cmd" "$@"
    ok_or_die "Command $cmd returned non-zero exit code"
}

main "$@"
