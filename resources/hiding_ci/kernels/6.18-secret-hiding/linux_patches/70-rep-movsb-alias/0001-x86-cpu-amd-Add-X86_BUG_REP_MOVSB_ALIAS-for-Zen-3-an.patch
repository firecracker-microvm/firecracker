From 8917b9caf813ff025a2694f4ece5ff0159d8e914 Mon Sep 17 00:00:00 2001
From: Jack Thomson <jackabt@amazon.com>
Date: Tue, 15 Sep 2026 08:57:04 +0000
Subject: [PATCH 1/2] x86/cpu/amd: Add X86_BUG_REP_MOVSB_ALIAS for Zen 3 and
 Zen 4

On Zen 3 and Zen 4, REP MOVSB falls back to a slow microcode path of one
byte per cycle whenever the destination address is 1..15 bytes ahead of
the source address modulo 4K, independently of the absolute alignment of
either operand and of the copy length. Measured on an EPYC 9R14 with
32 KB copies between cache-hot buffers:

  (dst - src) mod 4K    0     4     8    12    16    32    64   2048
  REP MOVSB  GB/s    57.5   3.5   3.5   3.5  55.5  56.4  57.1  57.5
  REP MOVSQ  GB/s    57.3  27.4  27.4  27.4  27.4  33.9  57.2  57.5
  AVX2 loop  GB/s    57.9  53.3  53.3  53.3  53.3  53.9  57.7  56.4

A Sapphire Rapids Xeon copies at 41-43 GB/s for every distance with all
three methods. glibc ran into the same behaviour (BZ 30994, "REP MOVSB
performance suffers from page aliasing on Zen 4": "if the source is
aligned and the destination is not the performance can be 20x slower")
and stopped using REP MOVSB for memcpy/memmove on these cores in 2.40
("x86: Fix Zen3/Zen4 ERMS selection (BZ 30994)"), so the kernel is now
the main remaining user of REP MOVSB on them.

Add a bug flag so that the kernel's REP MOVSB users can steer clear of
the pathological distances, and set it for Zen 3 and Zen 4. Zen 5 has
not been measured.

Link: https://sourceware.org/bugzilla/show_bug.cgi?id=30994
Signed-off-by: Jack Thomson <jackabt@amazon.com>
---
 arch/x86/include/asm/cpufeatures.h | 1 +
 arch/x86/kernel/cpu/amd.c          | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/arch/x86/include/asm/cpufeatures.h b/arch/x86/include/asm/cpufeatures.h
index f4c85555b7e4..ead3eecbeb7e 100644
--- a/arch/x86/include/asm/cpufeatures.h
+++ b/arch/x86/include/asm/cpufeatures.h
@@ -558,6 +558,7 @@
 #define X86_BUG_ITS_NATIVE_ONLY		X86_BUG( 1*32+ 8) /* "its_native_only" CPU is affected by ITS, VMX is not affected */
 #define X86_BUG_TSA			X86_BUG( 1*32+ 9) /* "tsa" CPU is affected by Transient Scheduler Attacks */
 #define X86_BUG_VMSCAPE			X86_BUG( 1*32+10) /* "vmscape" CPU is affected by VMSCAPE attacks from guests */
+#define X86_BUG_REP_MOVSB_ALIAS		X86_BUG( 1*32+11) /* "rep_movsb_alias" REP MOVSB is very slow when the destination is 1-15 bytes past the source modulo 4K */
 
 #define X86_BUG_TLBI			X86_BUG( 1*32+12) /* "tlbi" AMD TLBI Erratum #1718 */
 #endif /* _ASM_X86_CPUFEATURES_H */
diff --git a/arch/x86/kernel/cpu/amd.c b/arch/x86/kernel/cpu/amd.c
index ca4265a1f4bb..48028b3f148c 100644
--- a/arch/x86/kernel/cpu/amd.c
+++ b/arch/x86/kernel/cpu/amd.c
@@ -1011,6 +1011,8 @@ static void init_amd_zen3(struct cpuinfo_x86 *c)
 		if (!cpu_has(c, X86_FEATURE_BTC_NO))
 			set_cpu_cap(c, X86_FEATURE_BTC_NO);
 	}
+
+	set_cpu_bug(c, X86_BUG_REP_MOVSB_ALIAS);
 }
 
 static void init_amd_zen4(struct cpuinfo_x86 *c)
@@ -1028,6 +1030,8 @@ static void init_amd_zen4(struct cpuinfo_x86 *c)
 		clear_cpu_cap(c, X86_FEATURE_V_VMSAVE_VMLOAD);
 		break;
 	}
+
+	set_cpu_bug(c, X86_BUG_REP_MOVSB_ALIAS);
 }
 
 static const struct x86_cpu_id zen5_rdseed_microcode[] = {
