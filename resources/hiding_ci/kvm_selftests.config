# Guest boot under virtme-ng: 9p root over virtio plus a virtio console.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_OVERLAY_FS=y
# KVM selftests (tools/testing/selftests/kvm/config) plus NUMA and hugepage coverage.
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_USERFAULTFD=y
CONFIG_IDLE_PAGE_TRACKING=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_NUMA=y
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_DEBUG_FS=y
